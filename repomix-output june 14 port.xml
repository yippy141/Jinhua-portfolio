<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Jinhua Yip — Sea of Consciousness</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Newsreader:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
<style>
  :root {
    --bg-0: #050807;
    --bg-1: #07100e;
    --ink: #d8e8e2;
    --ink-soft: #8aa39c;
    --ink-faint: #4a605a;
    --line: #1a2a26;
    --line-strong: #2a4039;
    --accent: #7fd9b8;
    --accent-warm: #e8c87f;
    --accent-cool: #9fc8e0;
    --danger: #c66;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; height: 100%; background: var(--bg-0); color: var(--ink); font-family: 'Newsreader', Georgia, serif; overflow: hidden; }
  body {
    background:
      radial-gradient(ellipse at 20% 10%, rgba(20, 60, 50, 0.18), transparent 55%),
      radial-gradient(ellipse at 80% 110%, rgba(40, 70, 90, 0.14), transparent 55%),
      linear-gradient(180deg, #050a0a 0%, #03080a 60%, #020607 100%);
  }
  body::before {
    /* fine grain */
    content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 1;
    background-image:
      radial-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      radial-gradient(rgba(255,255,255,0.012) 1px, transparent 1px);
    background-size: 3px 3px, 7px 7px;
    background-position: 0 0, 1px 2px;
    mix-blend-mode: screen;
    opacity: 0.4;
  }
  body::after {
    /* vignette */
    content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 2;
    background: radial-gradient(ellipse at 50% 50%, transparent 50%, rgba(0,0,0,0.45) 100%);
  }

  #bg-canvas { position: fixed; inset: 0; z-index: 0; width: 100%; height: 100%; display: block; }
  #app { position: relative; z-index: 10; height: 100%; }

  /* ────── taxonomy drift ────── */
  .taxonomy-layer { position: fixed; inset: 0; z-index: 3; pointer-events: none; overflow: hidden; }
  .tax-word {
    position: absolute; left: -40%;
    font-family: 'Newsreader', serif; font-style: italic; white-space: nowrap;
    animation: drift linear infinite;
    will-change: transform;
  }
  .tax-latin { font-weight: 400; }
  .tax-common { font-family: 'IBM Plex Mono', monospace; font-style: normal; font-size: 0.65em; letter-spacing: 0.08em; text-transform: lowercase; }
  .tax-d0 { font-size: 18px; opacity: 0.10; color: #6fa899; }
  .tax-d1 { font-size: 28px; opacity: 0.07; color: #4a807a; }
  .tax-d2 { font-size: 14px; opacity: 0.13; color: #8db8a9; }
  .tax-d3 { font-size: 22px; opacity: 0.05; color: #5c8e85; }
  @keyframes drift {
    from { transform: translateX(0); }
    to   { transform: translateX(180vw); }
