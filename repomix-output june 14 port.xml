/* ════════════ FRONT DOOR (shared deep-water shell) ════════════ */
.fd {
  position: relative; width: 1440px; height: 900px; overflow: hidden;
  color: var(--d-ink); font-family: var(--serif);
}
.fd-fog {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(120% 90% at 72% 22%, rgba(53,107,102,0.22), transparent 55%),
    radial-gradient(90% 80% at 18% 95%, rgba(12,26,23,0.9), transparent 60%),
    radial-gradient(140% 120% at 50% 50%, transparent 45%, rgba(3,8,7,0.65) 100%),
    linear-gradient(180deg, #08130F 0%, #07100F 55%, #050B0A 100%);
}
.fd-contours { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.5; }
.fd-graph { position: absolute; inset: 0; width: 100%; height: 100%; }

.fd-node { position: absolute; transform: translate(-50%,-50%); display: flex; flex-direction: column; align-items: center; gap: 6px;
  animation: fdbob ease-in-out infinite; }
@keyframes fdbob { 0%,100%{ transform: translate(-50%,-50%);} 50%{ transform: translate(-50%,calc(-50% - 9px));} }
.fd-dot { display: block; border: 1px solid; border-radius: 50%; }
.fd-label { font-size: 11px; letter-spacing: 0.12em; font-weight: 500; text-shadow: 0 1px 7px rgba(3,8,7,0.95), 0 0 2px rgba(3,8,7,0.9); white-space: nowrap; }

/* active popover */
.fd-pop {
  position: absolute; transform: translate(28px, -50%); width: 248px; z-index: 6;
  background: rgba(8,18,16,0.86); border: 1px solid var(--d-oxblood);
  padding: 14px; display: flex; flex-direction: column; gap: 10px; border-radius: 4px;
}
.fd-pop-head { display: flex; justify-content: space-between; align-items: center; }
.fd-pop-code { font-size: 13px; letter-spacing: 0.14em; color: var(--d-oxblood); }
.fd-pop-video { position: relative; aspect-ratio: 16/10; background: #0a1614; border: 1px solid var(--d-rule); overflow: hidden;
  display: flex; align-items: flex-end; padding: 7px; }
.fd-pop-rec { font-size: 9px; letter-spacing: 0.14em; color: var(--d-ink-2); }
.fd-pop-scan { position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgba(255,255,255,0.03) 0 1px, transparent 1px 3px); }
.fd-pop-title { font-size: 17px; line-height: 1.1; }
.fd-pop-meta { font-size: 10px; letter-spacing: 0.1em; color: var(--d-ink-2); text-transform: uppercase; }

/* nav (shared) */
.fd-nav, .snd-col, .fd-hero, .fd-foot { z-index: 5; }
.fd-nav { position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: flex-start; padding: 34px 48px; }
.fd-wordmark { font-size: 25px; line-height: 1; color: var(--d-ink); }
.fd-tag { font-size: 10px; letter-spacing: 0.24em; color: var(--d-ink-2); margin-top: 5px; }
.fd-links { display: flex; align-items: center; gap: 22px; font-size: 12.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--d-ink-2); }
.fd-links a { cursor: pointer; }
.fd-links a:hover { color: var(--d-ink); }
.fd-sep { width: 1px; height: 14px; background: var(--d-rule); }
.fd-ico { font-size: 12px; color: var(--d-ink-2); width: 22px; height: 22px; display: grid; place-items: center; border: 1px solid var(--d-rule); border-radius: 2px; }

/* hero A */
.fd-hero { position: absolute; left: 48px; bottom: 132px; max-width: 620px; }
.fd-h1 { font-size: 62px; line-height: 1.02; font-weight: 500; letter-spacing: -0.015em; margin: 18px 0 0; color: var(--d-ink); text-wrap: balance; }
.fd-positioning { font-size: 13px; line-height: 1.7; color: var(--d-ink-2); letter-spacing: 0.02em; max-width: 460px; margin: 22px 0 0; }
.fd-cta { display: flex; align-items: center; gap: 22px; margin-top: 28px; }
.fd-enter { font-size: 14px; letter-spacing: 0.04em; color: var(--paper); background: var(--d-oxblood); padding: 11px 20px; border-radius: 3px; cursor: pointer; }
.fd-enter:hover { background: var(--d-oxblood-soft); }
.fd-drift { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--d-ink-2); }

/* footer legend */
.fd-foot { position: absolute; left: 48px; right: 48px; bottom: 30px; display: flex; justify-content: space-between; align-items: center; gap: 48px;
  font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--d-ink-2);
  border-top: 1px solid var(--d-rule); padding-top: 15px; }
.fd-foot span { white-space: nowrap; }

/* ════════════ FRONT DOOR B — The Sounding ════════════ */
.snd-tax { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
.snd-word { position: absolute; left: -30%; font-style: italic; white-space: nowrap; color: #6fa899; animation: snddrift linear infinite; }
@keyframes snddrift { from { transform: translateX(0);} to { transform: translateX(200vw);} }
.snd-col { position: absolute; left: 48px; top: 220px; max-width: 600px; }
.snd-h1 { font-size: 52px; line-height: 1.08; font-weight: 500; letter-spacing: -0.012em; margin: 16px 0 0; color: var(--d-ink); }
