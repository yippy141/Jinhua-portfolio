  .nav > * { pointer-events: auto; }
  .nav-left { display: flex; align-items: baseline; gap: 16px; }
  .brand { font-family: 'Instrument Serif', serif; font-size: 28px; letter-spacing: 0.005em; color: var(--ink); }
  .brand-sub { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-faint); }
