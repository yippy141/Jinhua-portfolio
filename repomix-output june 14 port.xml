  /* ────── controls ────── */
  .controls { position: fixed; top: 90px; right: 40px; z-index: 30; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .ctrl {
    background: rgba(8, 14, 14, 0.7); border: 1px solid var(--line-strong);
    color: var(--ink-soft); font-family: 'IBM Plex Mono', monospace; font-size: 10px;
    letter-spacing: 0.18em; text-transform: uppercase; padding: 8px 14px; cursor: pointer;
