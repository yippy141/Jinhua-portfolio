.snd-line { position: absolute; right: 96px; top: 150px; bottom: 80px; width: 360px; }
.snd-axis { position: absolute; left: 8px; top: 0; bottom: 0; width: 1px; background: var(--d-rule); }
.snd-surface, .snd-floor { position: absolute; left: 24px; font-size: 10px; letter-spacing: 0.18em; color: var(--d-ink-2); }
.snd-surface { top: -22px; } .snd-floor { bottom: -26px; }
.snd-mark { position: absolute; left: 0; right: 0; display: flex; align-items: center; gap: 14px; }
.snd-tick { width: 17px; height: 1px; flex: none; }
.snd-mark-body { display: flex; flex-direction: column; gap: 1px; flex: 1; }
.snd-code { font-size: 10px; letter-spacing: 0.16em; }
.snd-name { font-size: 19px; color: var(--d-ink); line-height: 1.1; }
.snd-depth { font-size: 10px; color: var(--d-ink-2); letter-spacing: 0.08em; }

/* ════════════ READING ROOM — warm paper ════════════ */
.rr { position: relative; width: 1440px; height: 900px; overflow: hidden; background: var(--paper); color: var(--ink); font-family: var(--serif);
  padding: 0 64px; }
.rr-nav { display: flex; justify-content: space-between; align-items: center; padding: 30px 0 22px; }
.rr-wordmark { font-size: 24px; color: var(--ink); }
.rr-links { display: flex; gap: 26px; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); }
.rr-links a { cursor: pointer; padding-bottom: 3px; }
.rr-links a:hover { color: var(--ink); }
.rr-links a.is-active { color: var(--oxblood); border-bottom: 1px solid var(--oxblood); }
.rr-rule { height: 1px; background: var(--ink); opacity: 0.85; }

.rr-mast { display: grid; grid-template-columns: 1.35fr 1fr; gap: 56px; align-items: end; padding: 40px 0 30px; }
.rr-h1 { font-size: 44px; line-height: 1.06; font-weight: 500; letter-spacing: -0.015em; margin: 14px 0 0; max-width: 13ch; }
.rr-lede { font-size: 17px; line-height: 1.6; color: var(--ink-2); max-width: 44ch; }

.rr-filters { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 12px 0; }
.rr-filter-group { display: flex; gap: 6px; }
.rr-filter { font-size: 12px; letter-spacing: 0.06em; padding: 6px 13px; border: 1px solid transparent; background: none; color: var(--ink-2); cursor: pointer; border-radius: 3px; }
.rr-filter:hover { color: var(--ink); }
.rr-filter.is-on { background: var(--ink); color: var(--paper); }
.rr-count { font-size: 11px; letter-spacing: 0.16em; color: var(--ink-2); }

.rr-list { margin-top: 4px; }
.rr-row { display: grid; grid-template-columns: 150px 1fr 230px; gap: 36px; padding: 22px 0; border-bottom: 1px solid var(--rule); align-items: start; }
.rr-row:hover { background: var(--paper-2); margin: 0 -16px; padding: 22px 16px; border-radius: 3px; }
.rr-row-id { display: flex; flex-direction: column; gap: 6px; padding-top: 4px; }
.rr-code { font-size: 14px; letter-spacing: 0.12em; color: var(--ink); }
.rr-tier { font-size: 9.5px; letter-spacing: 0.2em; color: var(--ink-2); }
